+    private void awaitTopicMetadata(java.util.Collection<TopicPartition> topicPartitions) throws InterruptedException, TimeoutException {
+        long nowMs = time.milliseconds();
+        long remainingWaitMs = maxBlockTimeMs;
+        Set<String> topics = new HashSet<>();
+
+        for (TopicPartition tp : topicPartitions) {
+            topics.add(tp.topic());
+        }
+
+        for (String topic : topics) {
+            metadata.add(topic, nowMs);
+        }
+
+        int version = metadata.requestUpdate(false);
+        sender.wakeup();
+
+        try {
+            metadata.awaitUpdate(version, remainingWaitMs);
+        } catch (TimeoutException ex) {
+            throw new TimeoutException("Timeout waiting for metadata update for sendOffsetsToTransaction", ex);
+        }
+    }
