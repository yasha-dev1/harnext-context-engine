+package org.apache.kafka.coordinator.group.api.streams;
+
+import org.apache.kafka.common.Configurable;
+
+import java.util.concurrent.CompletableFuture;
+
+/**
+ * SPI for brokers to store, retrieve, and delete Kafka Streams topology descriptions
+ * for Streams groups (KIP-1331).
+ */
+public interface StreamsGroupTopologyDescriptionPlugin extends Configurable, AutoCloseable {
+
+    /**
+     * Store a topology description for a Streams group.
+     *
+     * @param groupId The group ID
+     * @param epoch The topology epoch
+     * @param topologyDescription The topology description to store
+     * @return A CompletableFuture that completes when the topology has been stored.
+     *         On permanent failure, completes exceptionally with
+     *         StreamsTopologyDescriptionPermanentFailureException.
+     *         On transient failure, completes exceptionally with any other exception.
+     */
+    CompletableFuture<Void> setTopology(
+        String groupId,
+        int epoch,
+        Object topologyDescription
+    );
+
+    /**
+     * Delete a topology description for a Streams group.
+     *
+     * @param groupId The group ID
+     * @return A CompletableFuture that completes when the topology has been deleted.
+     *         On permanent failure, completes exceptionally with
+     *         StreamsTopologyDescriptionPermanentFailureException.
+     *         On transient failure, completes exceptionally with any other exception.
+     */
+    CompletableFuture<Void> deleteTopology(String groupId);
+}
