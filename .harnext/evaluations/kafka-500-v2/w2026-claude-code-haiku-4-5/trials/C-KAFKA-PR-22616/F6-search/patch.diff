+package org.apache.kafka.coordinator.group.api.streams;
+
+/**
+ * Exception thrown by StreamsGroupTopologyDescriptionPlugin to signal a permanent
+ * failure that should not be retried. The broker records the failed epoch and does
+ * not solicit updates for that epoch again.
+ */
+public class StreamsTopologyDescriptionPermanentFailureException extends Exception {
+
+    public StreamsTopologyDescriptionPermanentFailureException(String message) {
+        super(message);
+    }
+
+    public StreamsTopologyDescriptionPermanentFailureException(String message, Throwable cause) {
+        super(message, cause);
+    }
+}
