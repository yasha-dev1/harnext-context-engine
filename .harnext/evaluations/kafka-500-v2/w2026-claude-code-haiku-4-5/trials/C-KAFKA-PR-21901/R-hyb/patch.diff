+    private Set<TopicPartition> seekByTimestampForWindowedStores(final Set<TopicPartition> newPartitionsToSeekByTimestamp) {
+        final Set<TopicPartition> partitionsFailedToSeek = new HashSet<>(newPartitionsToSeekByTimestamp);
+
+        // Build a map of TopicPartition -> timestamp to search for
+        final Map<TopicPartition, Long> timestampsToSearch = new HashMap<>();
+
+        for (final TopicPartition partition : newPartitionsToSeekByTimestamp) {
+            final ChangelogMetadata changelogMetadata = changelogs.get(partition);
+            if (changelogMetadata != null) {
+                final StateStoreMetadata storeMetadata = changelogMetadata.storeMetadata;
+                final long retentionPeriod = storeMetadata.retentionPeriod();
+                // Calculate the timestamp for the first offset we need to restore
+                // We want to seek to data that is at least retentionPeriod old
+                final long timestampToSearch = time.milliseconds() - retentionPeriod;
+                timestampsToSearch.put(partition, timestampToSearch);
+            }
+        }
+
+        if (timestampsToSearch.isEmpty()) {
+            return partitionsFailedToSeek;
+        }
+
+        try {
+            final Map<TopicPartition, OffsetAndTimestamp> offsetsByTimestamp = restoreConsumer.offsetsForTimes(timestampsToSearch);
+
+            for (final TopicPartition partition : newPartitionsToSeekByTimestamp) {
+                final OffsetAndTimestamp offsetAndTimestamp = offsetsByTimestamp.get(partition);
+                if (offsetAndTimestamp != null) {
+                    // Seek to the offset returned by offsetsForTimes
+                    restoreConsumer.seek(partition, offsetAndTimestamp.offset());
+                    log.debug("Seeked changelog partition {} to offset {} using timestamp-based seeking to avoid restoring outdated records.",
+                        partition, offsetAndTimestamp.offset());
+                    partitionsFailedToSeek.remove(partition);
+                } else {
+                    // If broker returns null for this partition, we'll fall back to seeking to beginning
+                    log.debug("Broker returned null for offsetsForTimes for partition {}, will fall back to seeking to beginning.",
+                        partition);
+                }
+            }
+        } catch (final KafkaException e) {
+            log.debug("Failed to seek by timestamp for windowed stores, will fall back to seeking to beginning: {}", e.getMessage());
+            // On error, all these partitions will be seeked to beginning in the caller
+        }
+
+        return partitionsFailedToSeek;
+    }
