+    private void seekWindowedChangelogsByTimestamp(final Set<TopicPartition> windowedPartitions) {
+        // build a map of partitions to timestamps for offsetsForTimes call
+        final Map<TopicPartition, Long> timestampsToSearch = new HashMap<>();
+        final Map<TopicPartition, Long> retentionPeriods = new HashMap<>();
+
+        for (final TopicPartition partition : windowedPartitions) {
+            final ChangelogMetadata changelogMetadata = changelogs.get(partition);
+            final StateStoreMetadata storeMetadata = changelogMetadata.storeMetadata;
+            final long retentionPeriod = storeMetadata.retentionPeriod();
+            final long targetTimestamp = time.milliseconds() - retentionPeriod;
+            timestampsToSearch.put(partition, targetTimestamp);
+            retentionPeriods.put(partition, retentionPeriod);
+        }
+
+        // try to find offsets by timestamp
+        final Map<TopicPartition, OffsetAndTimestamp> offsetsForTimes = restoreConsumer.offsetsForTimes(timestampsToSearch);
+
+        final Set<TopicPartition> partitionsToSeekToBeginning = new HashSet<>();
+
+        for (final TopicPartition partition : windowedPartitions) {
+            final OffsetAndTimestamp offsetAndTimestamp = offsetsForTimes.get(partition);
+
+            if (offsetAndTimestamp != null) {
+                // seek to the offset returned by offsetsForTimes
+                restoreConsumer.seek(partition, offsetAndTimestamp.offset());
+                log.debug("Seeked changelog partition {} to offset {} based on timestamp {} for retention period {}",
+                    partition, offsetAndTimestamp.offset(), timestampsToSearch.get(partition), retentionPeriods.get(partition));
+            } else {
+                // if broker returns null for offsetsForTimes, fall back to seekToBeginning
+                partitionsToSeekToBeginning.add(partition);
+                log.debug("Could not find offset by timestamp for changelog partition {}, will seek to beginning", partition);
+            }
+        }
+
+        if (!partitionsToSeekToBeginning.isEmpty()) {
+            restoreConsumer.seekToBeginning(partitionsToSeekToBeginning);
+        }
+    }
