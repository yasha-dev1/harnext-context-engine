+package org.apache.kafka.clients.consumer.internals.events;
+
+import org.apache.kafka.clients.consumer.internals.StreamsRebalanceData;
+import org.apache.kafka.common.TopicPartition;
+
+import java.util.Objects;
+import java.util.Set;
+
+public class StreamsTasksAssignedEvent extends CompletableBackgroundEvent<Void> {
+
+    private final StreamsRebalanceData.Assignment assignment;
+    private final Set<TopicPartition> assignedPartitions;
+    private final Set<TopicPartition> addedPartitions;
+
+    public StreamsTasksAssignedEvent(final StreamsRebalanceData.Assignment assignment,
+                                     final Set<TopicPartition> assignedPartitions,
+                                     final Set<TopicPartition> addedPartitions) {
+        super(Type.STREAMS_TASKS_ASSIGNED, Long.MAX_VALUE);
+        this.assignment = Objects.requireNonNull(assignment);
+        this.assignedPartitions = Objects.requireNonNull(assignedPartitions);
+        this.addedPartitions = Objects.requireNonNull(addedPartitions);
+    }
+
+    public StreamsRebalanceData.Assignment assignment() {
+        return assignment;
+    }
+
+    public Set<TopicPartition> assignedPartitions() {
+        return assignedPartitions;
+    }
+
+    public Set<TopicPartition> addedPartitions() {
+        return addedPartitions;
+    }
+
+    @Override
+    protected String toStringBase() {
+        return super.toStringBase() +
+            ", assignment=" + assignment +
+            ", assignedPartitions=" + assignedPartitions +
+            ", addedPartitions=" + addedPartitions;
+    }
+}
