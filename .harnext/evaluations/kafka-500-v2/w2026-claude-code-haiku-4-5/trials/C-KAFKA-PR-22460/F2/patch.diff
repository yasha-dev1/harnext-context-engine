+    private void awaitTopicsMetadata(Set<String> topics) throws InterruptedException {
+        long nowMs = time.milliseconds();
+        long maxWaitMs = maxBlockTimeMs;
+
+        Cluster cluster = metadata.fetch();
+        for (String topic : topics) {
+            if (cluster.invalidTopics().contains(topic)) {
+                throw new InvalidTopicException(topic);
+            }
+        }
+
+        long remainingWaitMs = maxWaitMs;
+        long elapsed = 0;
+        long nowNanos = time.nanoseconds();
+
+        // Add all topics to metadata and request updates
+        while (true) {
+            for (String topic : topics) {
+                log.trace("Requesting metadata update for topic {}.", topic);
+                metadata.add(topic, nowMs + elapsed);
+                int version = metadata.requestUpdateForTopic(topic);
+                sender.wakeup();
+                try {
+                    metadata.awaitUpdate(version, remainingWaitMs);
+                } catch (TimeoutException ex) {
+                    final String errorMessage = String.format("Topics %s not present in metadata after %d ms.",
+                        topics, maxWaitMs);
+                    if (!topics.isEmpty()) {
+                        String firstTopic = topics.iterator().next();
+                        if (metadata.getError(firstTopic) != null) {
+                            throw new TimeoutException(errorMessage, metadata.getError(firstTopic).exception());
+                        }
+                    }
+                    throw new TimeoutException(errorMessage);
+                }
+            }
+
+            cluster = metadata.fetch();
+            elapsed = time.milliseconds() - nowMs;
+            if (elapsed >= maxWaitMs) {
+                final String errorMessage = String.format("Topics %s not present in metadata after %d ms.",
+                    topics, maxWaitMs);
+                if (!topics.isEmpty()) {
+                    String firstTopic = topics.iterator().next();
+                    if (metadata.getError(firstTopic) != null && metadata.getError(firstTopic).exception() instanceof RetriableException) {
+                        throw new TimeoutException(errorMessage, metadata.getError(firstTopic).exception());
+                    }
+                }
+                throw new TimeoutException(errorMessage);
+            }
+            for (String topic : topics) {
+                metadata.maybeThrowExceptionForTopic(topic);
+            }
+            remainingWaitMs = maxWaitMs - elapsed;
+
+            // Check if all topics have metadata
+            boolean allTopicsReady = true;
+            for (String topic : topics) {
+                if (cluster.partitionCountForTopic(topic) == null) {
+                    allTopicsReady = false;
+                    break;
+                }
+            }
+            if (allTopicsReady) {
+                break;
+            }
+        }
+
+        producerMetrics.recordMetadataWait(time.nanoseconds() - nowNanos);
+    }
