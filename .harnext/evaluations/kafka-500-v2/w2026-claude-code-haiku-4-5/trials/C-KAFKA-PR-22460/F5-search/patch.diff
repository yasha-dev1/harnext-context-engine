+                    }
+                    long elapsed = time.milliseconds() - nowMs;
+                    if (elapsed >= maxBlockTimeMs) {
+                        throw new TimeoutException("Timeout waiting for metadata refresh for topics in offsets map");
+                    }
+                    remainingWaitMs = maxBlockTimeMs - elapsed;
+                }
+            } catch (InterruptedException e) {
+                throw new InterruptException(e);
