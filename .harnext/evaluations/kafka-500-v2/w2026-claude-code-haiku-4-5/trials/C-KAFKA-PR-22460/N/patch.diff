+    private void awaitTopicMetadata(Collection<TopicPartition> topicPartitions) throws InterruptedException {
+        long nowMs = time.milliseconds();
+        long remainingWaitMs = maxBlockTimeMs;
+
+        Set<String> topics = topicPartitions.stream()
+            .map(TopicPartition::topic)
+            .collect(Collectors.toSet());
+
+        // Add all topics to metadata
+        for (String topic : topics) {
+            metadata.add(topic, nowMs);
+        }
+
+        // Check if all topics have topic IDs in the metadata
+        Map<String, Uuid> topicIds = metadata.topicIds();
+        boolean allHaveTopicIds = true;
+        String firstTopicWithoutId = null;
+        for (String topic : topics) {
+            Uuid topicId = topicIds.get(topic);
+            if (topicId == null || topicId.equals(Uuid.ZERO_UUID)) {
+                allHaveTopicIds = false;
+                if (firstTopicWithoutId == null) {
+                    firstTopicWithoutId = topic;
+                }
+            }
+        }
+
+        if (allHaveTopicIds) {
+            return;
+        }
+
+        // Request metadata update for the first topic that doesn't have a topic ID
+        log.trace("Requesting metadata update for topic {}.", firstTopicWithoutId);
+        metadata.add(firstTopicWithoutId, nowMs);
+        int version = metadata.requestUpdateForTopic(firstTopicWithoutId);
+        sender.wakeup();
+        try {
+            metadata.awaitUpdate(version, remainingWaitMs);
+        } catch (TimeoutException ex) {
+            // If the metadata update times out, just return - this is not a fatal error.
+            // The TransactionManager will handle topic IDs being absent by sending the request
+            // with topic names instead.
+            log.trace("Metadata update for topic {} timed out, proceeding without topic IDs", firstTopicWithoutId);
+            return;
+        }
+
+        // Check for exceptions for any of the topics
+        for (String topic : topics) {
+            metadata.maybeThrowExceptionForTopic(topic);
+        }
+    }
+
