@@ -562,6 +562,20 @@ public class KafkaStatusBackingStore extends KafkaTopicBasedBackingStore impleme
         synchronized (this) {
             log.trace("Received connector {} status update {}", connector, status);
             CacheEntry<ConnectorStatus> entry = getOrAdd(connector);
+
+            // Ignore stale UNASSIGNED status from a different worker if current status is RUNNING with a higher generation
+            if (status.state() == ConnectorStatus.State.UNASSIGNED) {
+                ConnectorStatus current = entry.get();
+                if (current != null && current.state() == ConnectorStatus.State.RUNNING
+                        && !status.workerId().equals(current.workerId())
+                        && status.generation() < current.generation()
+                        && status.generation() != generation) {
+                    log.trace("Ignoring stale UNASSIGNED status for connector {} from worker {} and generation {} as current RUNNING status is from generation {}",
+                            connector, status.workerId(), status.generation(), current.generation());
+                    return;
+                }
+            }
+
             entry.put(status);
         }
     }
@@ -588,6 +602,20 @@ public class KafkaStatusBackingStore extends KafkaTopicBasedBackingStore impleme
         synchronized (this) {
             log.trace("Received task {} status update {}", id, status);
             CacheEntry<TaskStatus> entry = getOrAdd(id);
+
+            // Ignore stale UNASSIGNED status from a different worker if current status is RUNNING with a higher generation
+            if (status.state() == TaskStatus.State.UNASSIGNED) {
+                TaskStatus current = entry.get();
+                if (current != null && current.state() == TaskStatus.State.RUNNING
+                        && !status.workerId().equals(current.workerId())
+                        && status.generation() < current.generation()
+                        && status.generation() != generation) {
+                    log.trace("Ignoring stale UNASSIGNED status for task {} from worker {} and generation {} as current RUNNING status is from generation {}",
+                            id, status.workerId(), status.generation(), current.generation());
+                    return;
+                }
+            }
+
             entry.put(status);
         }
     }
