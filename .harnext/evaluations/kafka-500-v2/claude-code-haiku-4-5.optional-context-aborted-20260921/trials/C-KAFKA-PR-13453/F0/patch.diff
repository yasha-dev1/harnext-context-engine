+    private boolean shouldIgnoreStaleConnectorStatus(ConnectorStatus status, ConnectorStatus currentStatus) {
+        if (currentStatus == null) {
+            return false;
+        }
+        if (!isFenceableStatus(status)) {
+            return false;
+        }
+        if (!isRunningOrPausedStatus(currentStatus)) {
+            return false;
+        }
+        if (currentStatus.workerId().equals(status.workerId())) {
+            return false;
+        }
+        if (status.generation() >= currentStatus.generation()) {
+            return false;
+        }
+        return this.generation < status.generation();
+    }
+
+    private boolean shouldIgnoreStaleTaskStatus(TaskStatus status, TaskStatus currentStatus) {
+        if (currentStatus == null) {
+            return false;
+        }
+        if (!isFenceableStatus(status)) {
+            return false;
+        }
+        if (!isRunningOrPausedStatus(currentStatus)) {
+            return false;
+        }
+        if (currentStatus.workerId().equals(status.workerId())) {
+            return false;
+        }
+        if (status.generation() >= currentStatus.generation()) {
+            return false;
+        }
+        return this.generation < status.generation();
+    }
+
+    private boolean isFenceableStatus(AbstractStatus<?> status) {
+        return status.state() == AbstractStatus.State.UNASSIGNED
+                || status.state() == AbstractStatus.State.FAILED;
+    }
+
+    private boolean isRunningOrPausedStatus(AbstractStatus<?> status) {
+        return status.state() == AbstractStatus.State.RUNNING
+                || status.state() == AbstractStatus.State.PAUSED;
+    }
+
