--- a/connect/runtime/src/main/java/org/apache/kafka/connect/storage/KafkaStatusBackingStore.java
+++ b/connect/runtime/src/main/java/org/apache/kafka/connect/storage/KafkaStatusBackingStore.java
@@ -588,6 +588,24 @@ public class KafkaStatusBackingStore extends KafkaTopicBasedBackingStore impleme
         synchronized (this) {
             log.trace("Received task {} status update {}", id, status);
             CacheEntry<TaskStatus> entry = getOrAdd(id);
+
+            // Ignore stale UNASSIGNED statuses from earlier generations
+            // when we already have a RUNNING status from a newer generation.
+            // This handles the race condition during fast consecutive rebalances
+            // where a delayed UNASSIGNED record from an earlier generation arrives
+            // after the task has already been assigned to another worker.
+            if (status.state() == TaskStatus.State.UNASSIGNED) {
+                TaskStatus currentStatus = entry.get();
+                if (currentStatus != null
+                    && currentStatus.state() == TaskStatus.State.RUNNING
+                    && currentStatus.generation() > status.generation()) {
+                    log.trace("Ignoring stale UNASSIGNED status for task {} from generation {} "
+                              + "(current RUNNING status is from generation {})",
+                              id, status.generation(), currentStatus.generation());
+                    return;
+                }
+            }
+
             entry.put(status);
         }
     }
